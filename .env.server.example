# Copy to .env.server and replace every CHANGE_ME value.
SERVER_PUBLIC_IP=203.0.113.10
CCAAS_DEMO_TENANT_ID=3FA85F64-5717-4562-B3FC-2C963F66AFA6

SQL_SA_PASSWORD=CHANGE_ME_32_CHARS
RABBITMQ_PASSWORD=CHANGE_ME_32_CHARS
MINIO_ROOT_USER=ccaas_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_32_CHARS
JWT_SIGNING_KEY=CHANGE_ME_BASE64_OR_64_RANDOM_CHARS
ASTERISK_ARI_USERNAME=ccaas
ASTERISK_ARI_PASSWORD=CHANGE_ME_32_CHARS
ASTERISK_AMI_PASSWORD=CHANGE_ME_32_CHARS
SIP_1001_PASSWORD=CHANGE_ME_24_CHARS
SIP_1002_PASSWORD=CHANGE_ME_24_CHARS
SIP_1003_PASSWORD=CHANGE_ME_24_CHARS

# First boot only. Set both false after the first successful login.
BOOTSTRAP_MIGRATE_DATABASE=true
BOOTSTRAP_SEED_DEMO_DATA=true

# Safe starting point for 6 vCPU / 12 GB RAM. Raise concurrency only after load testing.
AI_VOICE_MAX_CONCURRENT_CALLS=1
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
LOCAL_AI_SPEECH_PARALLEL=1
OLLAMA_MODEL=qwen3:1.7b
AI_VOICE_PROVIDER_TIMEOUT_SECONDS=120
APPOINTMENT_TIME_ZONE_ID=Asia/Dhaka
TELEPHONY_RECORDING_MAX_DURATION_SECONDS=15
TELEPHONY_RECORDING_MAX_SILENCE_SECONDS=2
